     if source_msg.get("role") != "assistant":
         return
 
+    # DeepSeek thinking mode requires reasoning_content echo-back, but the
+    # field is provider-facing thinking state. When thinking is explicitly
+    # disabled (for example, reasoning_effort: none), do not replay old
+    # thinking-mode state into the non-thinking request path.
+    thinking_disabled = getattr(agent, "_thinking_mode_disabled", None)
+    if (
+        callable(thinking_disabled)
+        and thinking_disabled()
+        and agent._needs_deepseek_tool_reasoning()
+    ):
+        api_msg.pop("reasoning_content", None)
+        return
+
     # 1. Explicit reasoning_content already set — preserve it verbatim
     # (includes DeepSeek/Kimi's own space-placeholder written at creation
     # time, and any valid reasoning content from the same provider).
